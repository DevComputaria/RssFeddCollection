mear-trump/articleshow/123023891.cms</guid><pubDate>2025-07-31T20:23:51+05:30</pubDate><dc:creator xmlns:dc="http://purl.org/dc/elements/1.1/">TOI World Desk</dc:creator><enclosure type="image/jpeg" url="https://static.toiimg.com/photo/msid-123023931,imgsize-732908.cms"/></item></channel></rss>